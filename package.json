{
  "name": "so-you-want-to-build-a-web-app",
  "private": true,
  "description": "So, you want to build a web app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app/issues"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev --webpack\"",
    "tina-generate-types": "tinacms dev --no-server",
    "build": "tinacms build && next build --webpack",
    "start": "tinacms build && next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "config": "node scripts/config.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.2.0",
    "@mui/material": "7.2.0",
    "@vercel/analytics": "1.1.1",
    "classnames": "2.5.1",
    "next": "16.3.3",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize.css": "13.0.0",
    "tinacms": "2.7.9",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@tinacms/cli": "1.9.9",
    "@types/node": "24.0.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "10.0.0",
    "axe-core": "4.10.3",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "browserslist": "last 2 versions",
  "sideEffects": false,
  "packageManager": "yarn@1.22.19"
}
