{
  "name": "so-you-want-to-build-a-web-app",
  "private": true,
  "type": "module",
  "description": "So, you want to build a web app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app.git"
  },
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app/issues"
  },
  "scripts": {
    "dev": "tinacms dev -c \"bun --bun vite dev\"",
    "tina-generate-types": "tinacms dev --no-server",
    "build": "tinacms build --local --skip-cloud-checks --skip-search-index -c \"NODE_ENV=production vite build\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "config": "node scripts/config.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource/noto-color-emoji": "5.3.2",
    "@fontsource/press-start-2p": "5.3.0",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/start-static-server-functions": "1.167.44",
    "@vercel/analytics": "2.0.1",
    "classnames": "2.5.1",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize.css": "13.0.0",
    "tinacms": "3.15.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tinacms/cli": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "browserslist": "last 2 versions",
  "sideEffects": [
    "*.css",
    "./util/prism*.ts"
  ],
  "packageManager": "bun@1.4.4"
}
