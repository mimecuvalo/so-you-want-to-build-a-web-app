{
  "name": "so-you-want-to-build-a-web-app",
  "private": true,
  "description": "So, you want to build a web app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app.git"
  },
  "license": "MIT",
  "engines": {
    "node": "26.x"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/so-you-want-to-build-a-web-app/issues"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev --webpack\"",
    "tina-generate-types": "tinacms dev --no-server",
    "build": "tinacms build && next build --webpack",
    "start": "tinacms build && next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "config": "node scripts/config.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@vercel/analytics": "2.0.1",
    "classnames": "2.5.1",
    "next": "16.4.3",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize.css": "13.0.0",
    "tinacms": "3.15.1"
  },
  "devDependencies": {
    "@tinacms/cli": "4.0.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "browserslist": "last 2 versions",
  "sideEffects": false,
  "packageManager": "yarn@1.22.22"
}
