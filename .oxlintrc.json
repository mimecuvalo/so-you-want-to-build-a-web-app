{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "rules": {},
  "ignorePatterns": [
    "node_modules",
    "dist",
    "out",
    "build",
    "coverage",
    "public",
    "tina/__generated__",
    "app/routeTree.gen.ts"
  ]
}
