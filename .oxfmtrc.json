{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "/.next/",
    "/out/",
    "/build/",
    "/coverage/",
    "/public/",
    "**/*.mdx",
    "tina/__generated__/",
    "tina/tina-lock.json"
  ]
}
