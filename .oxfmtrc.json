{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "/dist/",
    "/.output/",
    "/public/",
    "**/*.mdx",
    "**/*.gen.ts",
    "tina/__generated__/",
    "tina/tina-lock.json"
  ]
}
